# Databricks connection
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id

# Genie configuration
DATABRICKS_GENIE_SPACE_ID=your-genie-space-id

# Model Serving (used by AppKit serving() plugin at /api/serving/default/invoke|stream)
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-gpt-5-4-mini

# Mapbox
VITE_MAPBOX_TOKEN=<your-mapbox-token>
# ─── Dataset configuration ──────────────────────────────────────────────────
# Change these blocks to plug in a different dataset (see notebooks/data_engineering.ipynb).
# All VITE_ vars are baked into the client bundle — restart Vite (or rebuild) after changes.


# ────────────────────────────────────────────────────────────────────────────

# Server configuration
# PORT is used locally. In production, Databricks Apps injects DATABRICKS_APP_PORT automatically.
PORT=3000

VITE_DATASET_TABLE=<catalog>.<schema>.taxi_trips_demo
VITE_POINT_ZOOM_THRESHOLD=20
VITE_H3_RESOLUTIONS=5,7,9,11,13
VITE_H3_ZOOM_BREAKS=10,12,14,16
VITE_DATASET_LABEL=Trip
VITE_METRIC_1_LABEL=Revenue
VITE_METRIC_2_LABEL=Travel Time
VITE_CATEGORY_FILTER_LABEL=Trip Type
# Short (<2 mi city grid), Medium (2-10 mi borough crossings), Long (>10 mi airports)
VITE_CATEGORY_FILTER_OPTIONS=Short,Medium,Long
VITE_GROUP_FILTER_LABEL=Passenger Count
VITE_H3_HEIGHT_MULTIPLIER=3
VITE_POINT_RADIUS=0.5
