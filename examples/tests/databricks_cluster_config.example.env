# Databricks cluster test configuration (copy to databricks_cluster_config.env and fill in).
# Used by: test_bundle_on_databricks.py (local + WorkspaceClient), push_and_run_*_on_cluster.py (run on cluster),
# the stage-jar / stage-wheel launchers, and the gbx:uc:* / bench launchers.
#
# Uncommented lines are the project defaults: they work as they are. Commented lines are settings that are
# yours (a workspace, cluster, warehouse or secret): set the ones you need in your own copy. Only the real
# file (gitignored) ever holds those values. Never commit a token.
#
# Authentication — PREFER A NAMED PROFILE:
# - DATABRICKS_CONFIG_PROFILE=oauth-fe  (host + credentials come from ~/.databrickscfg;
#   host-scoped, refreshes silently for OAuth, and records which workspace a run hit)
# - DATABRICKS_HOST + DATABRICKS_TOKEN also work, but they are GLOBAL and override any
#   --profile for every SDK/CLI call in the same shell. Use them only where a profile is
#   unavailable — e.g. CI with an OAuth service-principal secret.
#
# For local test (bundle runs on your machine, uploads via SDK): the profile and GBX_BUNDLE_VOLUME_* below.
# For push-and-run (job runs on cluster): also CLUSTER_ID and GBX_ARTIFACT_VOLUME.
#   - gbx:data:stage-jar runs `mvn clean package -DskipTests` and stages JAR to GBX_ARTIFACT_VOLUME/ (overwrite if exists);
#     set GBX_BUNDLE_SKIP_JAR_UPLOAD=1 to build the JAR locally but skip the upload (GBX_BUNDLE_SKIP_JAR=1 skips build and upload)
#   - gbx:data:stage-wheel builds JAR first (stage-jar) unless GBX_BUNDLE_SKIP_JAR_UPLOAD=1 or GBX_BUNDLE_SKIP_JAR=1 (either skips the JAR build and upload), then builds and stages wheel to GBX_ARTIFACT_VOLUME/ and bundle volroot (overwrite if exists);
#     set GBX_BUNDLE_SKIP_WHEEL_UPLOAD=1 to use existing wheel (no build/upload)

# Preferred: a named profile from ~/.databrickscfg (see `databricks auth profiles`).
DATABRICKS_CONFIG_PROFILE=oauth-fe

# Fallback only (CI / no profile available). Setting these overrides the profile above
# for every SDK and CLI call in this shell. The token is a secret: it belongs in the real file or a secret store.
# DATABRICKS_HOST=<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=

# Where the Databricks CLI keeps OAuth credentials. Leave it unset to use the OS keyring (the default).
# DATABRICKS_AUTH_STORAGE=plaintext

# Volume root = /Volumes/<CATALOG>/<SCHEMA>/<VOLUME_NAME> (exactly 5 path segments).
# VOLUME_NAME must match Data Explorer exactly — hyphen vs underscore matters (e.g. sample-data not sample_data).
# On the cluster this path is FUSE-mounted; primitives use os.path / os.listdir / shutil.
# (When unset, the launchers fall back to main / default / geobrix_samples.)
GBX_BUNDLE_VOLUME_CATALOG=geospatial_docs
GBX_BUNDLE_VOLUME_SCHEMA=geobrix
GBX_BUNDLE_VOLUME_NAME=sample-data

# Required only for push_and_run_*_on_cluster.py: the all-purpose cluster the job runs on.
# CLUSTER_ID=<your-cluster-id>
# Volume directory gbx:data:stage-jar / stage-wheel upload the product JAR and wheel to (one current version).
# GBX_ARTIFACT_VOLUME=/Volumes/<catalog>/<schema>/<volume>/<dir>
# A wheel the bundle and bench launchers install on the cluster; unset, they pick the staged wheel for the runtime.
# GBX_BUNDLE_WHEEL_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>/geobrix-<version>+env6-py3-none-any.whl

# Used by gbx:uc:sql when --warehouse-id is not given (the SQL warehouse the UC statements run on).
# GBX_UC_WAREHOUSE_ID=<your-warehouse-id>
# Used by gbx:uc:tests ahead of GBX_UC_WAREHOUSE_ID: a warehouse sized for the gate (several clusters; the gate
# runs ~20 statements at once).
# GBX_UC_GATE_WAREHOUSE_ID=<your-gate-warehouse-id>

# Optional: skip build/upload when using gbx:data:stage-jar or gbx:data:stage-wheel
# GBX_BUNDLE_SKIP_JAR=1
# GBX_BUNDLE_SKIP_JAR_UPLOAD=1
# GBX_BUNDLE_SKIP_WHEEL_UPLOAD=1
# gbx:data:stage-jar: stage only the product JAR, not the bench tests JAR.
# GBX_BUNDLE_SKIP_TESTS_JAR_UPLOAD=1
# Print extra detail from the bundle test and the sample-bundle helper.
# GBX_BUNDLE_DEBUG=1

# Runner notebook location (preferred: dir + filename; else use GBX_BUNDLE_RUNNER_NOTEBOOK_PATH)
# Not set: the netcdf and corpus-staging launchers use /Workspace/Users/<you>/GeoBrix/runners (you = the signed-in user).
# GBX_RUNNER_DIR=/Workspace/Users/<you>/GeoBrix/runners
GBX_BUNDLE_RUNNER_NOTEBOOK=geobrix_bundle_runner.ipynb
GBX_PRIMITIVE_RUNNER_NOTEBOOK=geobrix_primitive_runner.ipynb
# Or single path (legacy):
# GBX_BUNDLE_RUNNER_NOTEBOOK_PATH=/Workspace/geobrix_bundle_runner.ipynb

# Bench launcher (push_and_run_bench_on_cluster.py / gbx:bench:*). Each default is shown in the comment.
# Corpus directory (default <volume root>/bench-corpus).
# GBX_BENCH_CORPUS=/Volumes/<catalog>/<schema>/<volume>/bench-corpus
# Results table (default <catalog>.<schema>.bench_results).
# GBX_BENCH_RESULTS_TABLE=<catalog>.<schema>.bench_results
# Bench tests JAR (default <volume root>/geobrix-<version>-tests.jar; also where gbx:data:stage-jar puts it).
# GBX_BENCH_TESTS_JAR_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>/geobrix-<version>-tests.jar
# Runner notebook path prefix in the workspace (default /Users/<you>/geobrix_bench_runner).
# GBX_BENCH_RUNNER_NOTEBOOK_PATH=/Users/<you>/geobrix_bench_runner
# SQL warehouse for the bench smoke stage (default: one is discovered when the run waits).
# GBX_BENCH_SQL_WAREHOUSE_ID=<your-warehouse-id>

# GeoBrix version the serverless smoke launcher looks for (default: the current release).
# GBX_VERSION=0.6.0
