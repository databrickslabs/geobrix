# Source of truth for the examples/tests harness — the cell-by-cell runner
# under examples/tests/run_notebooks_cell_by_cell.py and its fixtures.
# Pinned to match scripts/docker/Dockerfile / DBR 17.3 LTS where applicable;
# update via gbx:versions:audit.
#
# Regenerate the hash-pinned lock alongside any edit:
#   docker exec -it geobrix-dev bash -lc \
#     'cd /root/geobrix/examples/tests && \
#      uv pip compile --generate-hashes --python-version 3.12 \
#         --output-file requirements.txt requirements.in'
#
# Then install with --require-hashes to enforce supply-chain integrity:
#   pip install --require-hashes -r examples/tests/requirements.txt
#
# pytest is intentionally CI-matrix (9.1.1), not DBR's 8.3.5 — we don't run
# tests in DBR.
pytest==9.1.1
nbformat==5.10.4
nbconvert==7.17.2
testbook==0.4.2

# --- transitive packages floored at their security-patched releases ---
# nbconvert, nbclient and jupyter-client pull these; a floor stops a regenerated lock from
# resolving below the patched release. The harness runs on the host and does not mirror a DBR.
