{
  "datasets": [
    {
      "name": "ds_monitoring_status",
      "displayName": "Monitoring Status (current)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.cm_monitoring_status"
      ]
    },
    {
      "name": "ds_leaderboard",
      "displayName": "Operator Emissions Leaderboard",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.operator_emissions_leaderboard ORDER BY detection_rank "
      ]
    },
    {
      "name": "ds_leaderboard_top15",
      "displayName": "Operator Emissions Leaderboard (Top 15)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.operator_emissions_leaderboard ORDER BY detection_rank LIMIT 15 "
      ]
    },
    {
      "name": "ds_cm_plumes",
      "displayName": "Carbon Mapper Plumes (attributed)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.cm_plume_attributed"
      ]
    },
    {
      "name": "ds_activity_monthly",
      "displayName": "Carbon Mapper Activity (monthly)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.cm_activity_monthly ORDER BY month "
      ]
    },
    {
      "name": "ds_regional_trend",
      "displayName": "Regional CH4 Trend (daily)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.regional_ch4_trend_daily ORDER BY observation_date "
      ]
    },
    {
      "name": "ds_hotspot_latest",
      "displayName": "Hotspot Cells (latest overpass)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.hotspot_latest"
      ]
    },
    {
      "name": "ds_hotspot_persistence",
      "displayName": "Hotspot Persistence",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.hotspot_persistence"
      ]
    },
    {
      "name": "ds_aoi_kpis",
      "displayName": "AOI KPIs (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.aoi_kpis_latest"
      ]
    },
    {
      "name": "ds_plume_quant",
      "displayName": "Plume Quant (EMIT / GeoBrix cross-check)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.plume_quant ORDER BY observation_date DESC "
      ]
    }
  ],
  "pages": [
    {
      "name": "page_current_status",
      "displayName": "Current Status & Leakiest Operators",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "p1_title",
            "multilineTextboxSpec": {
              "lines": [
                "## Current Status & Leakiest Operators"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_subtitle",
            "multilineTextboxSpec": {
              "lines": [
                "Live Carbon Mapper methane detections across the Permian Basin \u2014 current monitoring status and the operators with the most confirmed plume detections."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_attribution",
            "multilineTextboxSpec": {
              "lines": [
                "Data \u00a9 Carbon Mapper \u2014 public-good data; users bring their own API token. For commercial or low-latency use, contact Planet Labs."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_kpi_plumes_90d",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monitoring_status",
                  "fields": [
                    {
                      "name": "plumes_last_90d",
                      "expression": "`plumes_last_90d`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "plumes_last_90d",
                  "displayName": "Plumes (last 90d)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Plumes Detected \u2014 Last 90 Days"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "p1_kpi_active_operators",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monitoring_status",
                  "fields": [
                    {
                      "name": "active_operators_last_90d",
                      "expression": "`active_operators_last_90d`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "active_operators_last_90d",
                  "displayName": "Active Operators (last 90d)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Active Operators \u2014 Last 90 Days"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "p1_kpi_days_since",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monitoring_status",
                  "fields": [
                    {
                      "name": "days_since_last_detection",
                      "expression": "`days_since_last_detection`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "days_since_last_detection",
                  "displayName": "Days Since Last Detection"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Days Since Last Detection"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "p1_kpi_total_plumes_all_time",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monitoring_status",
                  "fields": [
                    {
                      "name": "total_plumes_all_time",
                      "expression": "`total_plumes_all_time`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_plumes_all_time",
