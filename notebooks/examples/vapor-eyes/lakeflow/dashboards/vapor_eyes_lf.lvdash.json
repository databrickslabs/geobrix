            "y": 21,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p3_operator_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_operator_intensity",
                  "fields": [
                    {
                      "name": "operator",
                      "expression": "`operator`"
                    },
                    {
                      "name": "max(max_peak_ppmm)",
                      "expression": "MAX(`max_peak_ppmm`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "operator",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  },
                  "displayName": "Operator"
                },
                "y": {
                  "fieldName": "max(max_peak_ppmm)",
                  "scale": {
