            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "observation_date",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Observation Date"
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "fields": [
                    {
                      "fieldName": "regional_ch4_max",
                      "displayName": "Daily Max CH4"
                    },
                    {
                      "fieldName": "ch4_p95",
                      "displayName": "95th Percentile CH4"
