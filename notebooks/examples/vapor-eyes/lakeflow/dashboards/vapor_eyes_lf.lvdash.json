{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "AOI KPIs (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.aoi_kpis_latest"
      ]
    },
    {
      "name": "ds_hotspot_latest",
      "displayName": "Hotspot Cells (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.hotspot_latest"
      ]
    },
    {
      "name": "ds_regional_trend",
      "displayName": "Regional CH4 Trend (daily)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.regional_ch4_trend_daily"
      ]
    },
    {
      "name": "ds_hotspot_persistence",
      "displayName": "Hotspot Persistence",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.hotspot_persistence"
      ]
    },
    {
      "name": "ds_hotspot_persistence_top",
      "displayName": "Hotspot Persistence (top cells)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.hotspot_persistence ",
        "ORDER BY persistence_ratio DESC, dates_elevated DESC ",
        "LIMIT 25"
      ]
    },
    {
      "name": "ds_plume_leaderboard",
      "displayName": "Plume Leaderboard (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.plume_leaderboard_latest"
      ]
    },
    {
      "name": "ds_operator_intensity",
      "displayName": "Operator Intensity (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.operator_intensity_latest"
      ]
    },
    {
      "name": "ds_field_county_intensity",
      "displayName": "Field/County Intensity (latest)",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.field_county_intensity_latest"
      ]
    },
    {
      "name": "ds_plume_candidate_wells",
      "displayName": "Plume Candidate Wells",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.plume_candidate_wells"
      ]
    },
    {
      "name": "ds_detection_timeline",
      "displayName": "Plume Detection Timeline",
      "queryLines": [
        "SELECT * FROM geospatial_docs.vapor_eyes_lf.plume_detection_timeline"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_regional_screen",
      "displayName": "Regional Screen",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "p1_title",
            "multilineTextboxSpec": {
              "lines": [
                "## Regional Screen"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_subtitle",
            "multilineTextboxSpec": {
              "lines": [
                "AOI-wide methane snapshot: current KPIs, hotspot footprint, and the daily regional trend."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_kpi_total_plumes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_kpis",
                  "fields": [
                    {
                      "name": "total_plumes",
                      "expression": "`total_plumes`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_plumes",
                  "displayName": "Total Plumes Detected"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total Plumes"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "p1_kpi_max_conc",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_kpis",
                  "fields": [
                    {
                      "name": "max_concentration_ppmm",
