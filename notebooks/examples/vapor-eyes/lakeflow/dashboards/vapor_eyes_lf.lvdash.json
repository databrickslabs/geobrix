            "y": 8,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_hotspot_choropleth",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_hotspot_latest",
                  "fields": [
                    {
                      "name": "hex_geom",
                      "expression": "`hex_geom`"
                    },
                    {
                      "name": "ch4_max",
                      "expression": "`ch4_max`"
                    },
                    {
                      "name": "n_obs",
                      "expression": "`n_obs`"
                    },
                    {
                      "name": "h3_cellid",
                      "expression": "`h3_cellid`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "choropleth-map",
              "encodings": {
                "region": {
                  "regionType": "custom",
                  "fieldName": "hex_geom"
                },
                "color": {
                  "fieldName": "ch4_max",
                  "displayName": "Peak CH4 (ppm\u00b7m)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "extra": [
                  {
                    "fieldName": "n_obs",
                    "displayName": "Observations"
                  },
                  {
                    "fieldName": "h3_cellid",
                    "displayName": "H3 Cell"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Hotspot Cells by Peak CH4 Concentration"
              }
