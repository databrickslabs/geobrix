            "name": "p1_trend_line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_regional_trend",
                  "fields": [
                    {
                      "name": "observation_date",
                      "expression": "`observation_date`"
                    },
                    {
                      "name": "regional_ch4_max",
