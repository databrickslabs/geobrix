          "position": {
            "x": 3,
            "y": 6,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "p1_leaderboard_header",
            "multilineTextboxSpec": {
              "lines": [
                "### Leaderboard \u2014 Operators Ranked by Plume Detections"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_leaderboard_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_leaderboard",
                  "fields": [
                    {
                      "name": "detection_rank",
                      "expression": "`detection_rank`"
                    },
                    {
                      "name": "lead_operator",
                      "expression": "`lead_operator`"
                    },
                    {
                      "name": "plume_count",
                      "expression": "`plume_count`"
                    },
                    {
                      "name": "mean_emission_kg_hr",
                      "expression": "`mean_emission_kg_hr`"
                    },
                    {
                      "name": "max_emission_kg_hr",
                      "expression": "`max_emission_kg_hr`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "detection_rank",
                    "displayName": "Rank"
                  },
                  {
                    "fieldName": "lead_operator",
                    "displayName": "Operator"
                  },
                  {
                    "fieldName": "plume_count",
                    "displayName": "Plume Count"
                  },
                  {
                    "fieldName": "mean_emission_kg_hr",
                    "displayName": "Mean Emission (kg/hr)"
                  },
                  {
                    "fieldName": "max_emission_kg_hr",
                    "displayName": "Max Emission (kg/hr)"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Operator Emissions Leaderboard (Ranked by Detections)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 6,
            "height": 8
          }
        },
        {
          "widget": {
            "name": "p1_bar_header",
            "multilineTextboxSpec": {
              "lines": [
                "### Top 15 Operators by Plume Detections"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 18,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_operator_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_leaderboard_top15",
                  "fields": [
                    {
                      "name": "lead_operator",
                      "expression": "`lead_operator`"
                    },
                    {
                      "name": "max(plume_count)",
                      "expression": "MAX(`plume_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "lead_operator",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  },
                  "displayName": "Operator"
                },
                "y": {
                  "fieldName": "max(plume_count)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Plume Count"
                },
                "label": {
                  "show": true
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Top 15 Operators by Plume Count"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 19,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "p1_map_header",
            "multilineTextboxSpec": {
              "lines": [
                "### Live Plume Map \u2014 Colored by Emission Rate (kg/hr)"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 25,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "p1_plume_point_map",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_cm_plumes",
                  "fields": [
                    {
                      "name": "lon",
                      "expression": "`lon`"
                    },
                    {
                      "name": "lat",
                      "expression": "`lat`"
                    },
                    {
                      "name": "emission_rate_kg_hr",
                      "expression": "`emission_rate_kg_hr`"
                    },
                    {
                      "name": "lead_operator",
                      "expression": "`lead_operator`"
                    },
                    {
                      "name": "sector",
                      "expression": "`sector`"
                    },
                    {
                      "name": "plume_quality",
                      "expression": "`plume_quality`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "symbol-map",
              "encodings": {
                "coordinates": {
                  "coordinateType": "longitude-latitude",
                  "longitude": {
                    "fieldName": "lon"
                  },
                  "latitude": {
                    "fieldName": "lat"
                  }
                },
                "color": {
                  "fieldName": "emission_rate_kg_hr",
                  "displayName": "Emission Rate (kg/hr)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "extra": [
                  {
                    "fieldName": "lead_operator",
                    "displayName": "Operator"
                  },
                  {
                    "fieldName": "sector",
                    "displayName": "Sector"
                  },
                  {
                    "fieldName": "plume_quality",
                    "displayName": "Quality"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Carbon Mapper Plumes \u2014 Emission Rate"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 26,
            "width": 6,
            "height": 8
          }
        }
      ]
