# Keep in lockstep with requirements-light-env6-ci.in and the pyproject [light-base] floor.
netcdf4==1.7.4
# Zarr transactional stores (test/zarr): the [zarr_dbr19] extra. Ranges MUST match pyproject
# [zarr_dbr19] and requirements-light-env6-ci.in. gbx:test:python also installs the extra into a
# container that predates it; baking it here makes that a no-op.
zarr>=3.4.1,<3.5
numcodecs>=0.17,<0.18
