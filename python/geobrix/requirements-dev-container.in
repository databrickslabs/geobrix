ipywidgets==7.8.1
# jupyterlab is not used directly, but ipywidgets 7 -> widgetsnbextension -> notebook
# requires it; pinned here so it stays explicit and version-audited. The server side of the
# Jupyter stack (jupyterlab, jupyter_server, tornado, nbconvert) is held at security-patched
# releases above the DBR 17.3 versions: no GeoBrix code or test goes through it, and the
# container's notebook runs are not a DBR fidelity target. jupyterlab 4.6.x is the line that
# carries the patched notebook 7.6.3 (pulled through ipywidgets 7 -> widgetsnbextension), and
# it still resolves with ipywidgets 7 and pyzmq 25.
jupyterlab==4.6.4
jupyter_server==2.21.1
jupyter_core==5.9.1
jupyter_client==8.6.3
tornado==6.5.10
nbformat==5.10.4
nbconvert==7.17.2
pyzmq==25.1.1

