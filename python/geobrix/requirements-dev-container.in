# Source of truth for the geobrix-dev Docker image's Python deps.
# Consumed by scripts/docker/Dockerfile via (the lock for the image's own architecture):
#   pip install --require-hashes -r python/geobrix/requirements-dev-container.txt          (x86_64)
#   pip install --require-hashes -r python/geobrix/requirements-dev-container-aarch64.txt  (arm64)
#
# Regenerate BOTH hash-pinned locks alongside any edit (x86_64 first; the aarch64 compile takes its
# versions from it with -c, so the two pin the same versions), then check them:
#   cd python/geobrix
#   uv pip compile --generate-hashes --python-version 3.12 \
#      --python-platform x86_64-unknown-linux-gnu \
#      --output-file requirements-dev-container.txt requirements-dev-container.in
#   uv pip compile --generate-hashes --python-version 3.12 \
#      --python-platform aarch64-unknown-linux-gnu \
#      -c requirements-dev-container.txt \
#      --output-file requirements-dev-container-aarch64.txt requirements-dev-container.in
#   python3 scripts/ci/check_dev_container_locks.py
#
# All versions match scripts/docker/Dockerfile's ENV block (DBR 17.3 LTS-aligned
# where applicable). GDAL is NOT included — it's built from source and the
# Python binding is installed against the local gdal-config --version.
#
# Bump procedure: edit a pin, regenerate the .txt, rebuild the image with
# `scripts/docker/build_smart.sh --no-cache`, smoke-test.

# --- toolchain ---
# pip stays at the DBR 17.3 version: `gbx:test:python` installs the extras with it, so extras
# resolution is exercised the way a DBR 17.3 / env 5 cluster's pip would do it (the Dockerfile
# bootstraps this exact release by hash). setuptools and wheel are security-patched releases:
# nothing under test resolves through them.
pip==25.0.1
setuptools==84.2.1
wheel==0.46.2
cython==3.0.12
build==1.6.1

# --- DBR-aligned runtime / numeric stack ---
# numpy / pandas / pyarrow pinned to DBR 17.3 LTS installed versions:
# https://docs.databricks.com/aws/en/release-notes/runtime/17.3lts#installed-python-libraries
numpy==2.1.3
pandas==2.2.3
pyarrow==19.0.1
pyspark==4.0.0
py4j==0.10.9.9
requests==2.34.2

# --- geospatial dev stack (not in DBR) ---
geopandas==1.1.4
pystac-client==0.9.0
planetary-computer==1.0.0
# NASA EMIT (CH4) fetch for the sample EmitDownloader (Earthdata-Login auth).
earthaccess==0.18.0
# Constrain the transitive botocore (earthaccess -> s3fs -> aiobotocore -> botocore)
# to the Serverless base boto3 range (<1.44,>=1.43.101). Mirror in [stac] + light-ci.in.
botocore>=1.43.101,<1.44.0
# Overture static-STAC catalog traversal (gbx.sample.overture). pystac is the
# static-catalog reader used directly by OvertureClient._open_catalog; pystac-client
# (above) pulls it transitively, but listing it here pins it explicitly so any bump
# of pystac-client doesn't silently float pystac. Range matches [overture] extra.
pystac>=1.9,<2
rasterio==1.5.0
rioxarray==0.22.0
