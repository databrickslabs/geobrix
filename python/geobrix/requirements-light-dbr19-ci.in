# Source of truth for the DBR-19 classic light-tier CI job's Python deps.
# Consumed by a future .github/actions/light_dbr19_build via:
#   pip install --require-hashes -r python/geobrix/requirements-light-dbr19-ci.txt
#
# Regenerate the hash-pinned lock alongside any edit:
#   cd python/geobrix
#   uv pip compile --generate-hashes --python-version 3.12 \
#       --output-file requirements-light-dbr19-ci.txt requirements-light-dbr19-ci.in
#
# Classic DBR 19 variant: mapbox-vector-tile>=2.2 + protobuf 6.x. The CI
# environment has no Serverless grpcio-status constraint, so both variants
# currently resolve to similar dep trees; the separate lock documents intent
# and guards future divergence.
#
# Unlike requirements-ci.txt (heavyweight), this lock needs NO GDAL exception:
# the lightweight API uses rasterio's bundled-GDAL binary wheel, which is itself
# hash-pinned here. There is no separate native GDAL install and no JAR.
# Versions track classic DBR 19 / the dev container where applicable; bump in lockstep
# and regenerate the lock.

# --- build backend (for `python -m build` lightweight wheel) ---
build==1.4.4
setuptools==80.9.0
wheel==0.45.1

# --- runtime: pyspark local mode + pandas_udf (Arrow) ---
# base pyspark pulls neither pandas nor pyarrow; pandas_udf needs both.
# numpy / pandas / pyarrow pinned to DBR 17.3 LTS installed versions:
# https://docs.databricks.com/aws/en/release-notes/runtime/17.3lts#installed-python-libraries
pyspark==4.0.0
numpy==2.1.3
pandas==2.2.3
pyarrow==19.0.1

# --- lightweight raster stack (rasterio ships bundled GDAL — no native install) ---
rasterio==1.5.0
shapely==2.1.2

# --- entity-hardened XML parsing for external GDAL .vrt mosaic indexes ---
# (raster_gbx VRT expansion; guards untrusted .vrt against XXE / billion-laughs).
# Dep-free, pure Python. Matches the [light-base] pyproject floor + dev container.
defusedxml==0.7.1

# --- band math: focal filters / convolution (scipy.ndimage) + map-algebra (numexpr) ---
# scipy pinned to the DBR 17.3 LTS installed version. numexpr is NOT in DBR's
# library set, so it is pinned independently (safe math-expression evaluator for
# rst_mapalgebra — no arbitrary-code exec).
scipy==1.15.1
numexpr==2.11.0

# --- web-mercator XYZ tiling (rio-tiler bundles morecantile + color-operations) ---
rio-tiler==9.0.6

# --- COG output (rst_cog_convert) ---
rio-cogeo==7.0.2

# --- PMTiles tile-archive output (pmtiles_gbx writer) ---
pmtiles==3.7.0

# --- OGR-free vector reading (light *_gbx vector DataSources) ---
pyogrio==0.12.1
pyproj==3.7.2

# --- MVT (light pyvx) decode oracle used in test/pyvx/ ---
# DBR 19 variant — no <2.2 cap; >=2.2.0 already selected by the existing test oracle pin.
mapbox-vector-tile==2.2.0

# --- discrete global grids: raster->H3/quadbin aggregation ---
h3==4.4.2
quadbin==0.2.2

# --- contour (scikit-image) + viewshed (xarray-spatial) ---
scikit-image==0.26.0
xarray-spatial==0.9.9

# --- NetCDF decode for the netcdf_gbx reader (NetCDF-3 + NetCDF-4/HDF5: S5P,
# ERA5). xarray comes transitively via xarray-spatial; netcdf4 is the one new
# engine (single wheel bundling netcdf-c + HDF5). Pulls cftime. Keep in lockstep
# with the pyproject [light] floor and requirements-dev-container.in. ---
netcdf4==1.7.2

# --- STAC light client deps the test/stac suite actually imports: requests
# (stac/_download.py, module top) + tenacity (stac/_search.py search_one retry,
# exercised by test_search). pystac-client / planetary-computer are NOT needed --
# the suite stubs them (test/stac/_fake_catalog.py + an addPyFile pystac_client
# stub + monkeypatch), which is why they stay out of this light lock. Versions
# match requirements-dev-container.in. ---
requests==2.32.3
tenacity==9.1.4
# Cap idna to the dogfood serverless env-v6 base (3.11): uncapped it floats to the
# latest (3.19) and shadows the base, firing the "core package changed: idna" notice.
# Mirrors the [light_dbr19] pyproject pin (idna<3.12) and [light]'s idna<3.8.
idna<3.12
# NASA EMIT (CH4) fetch for the sample EmitDownloader (Earthdata-Login auth).
# Runtime-only for the real EMIT path; unit tests inject a fake. Keep in lockstep
# with the [stac] pyproject extra + requirements-dev-container.in.
earthaccess==0.18.0
# Constrain the transitive botocore (earthaccess -> s3fs -> aiobotocore -> botocore)
# to the Databricks Serverless base image's boto3 range (<1.41,>=1.40.45), so [stac]
# doesn't upgrade botocore past the base boto3. Holds aiobotocore on 2.x; s3fs/fsspec
# are unaffected. Mirror in the [stac] pyproject extra + requirements-dev-container.in.
botocore>=1.40.45,<1.41.0

# --- Overture static-STAC catalog traversal (gbx.sample.overture). pystac is the
# static-catalog reader (distinct from pystac-client, which is the search-API client
# the stac/ suite stubs). geopandas/pyarrow for parquet read are already pinned above.
# pystac>=1.9 is the floor set by rio-tiler (already in this lock); <2 matches the
# [overture] pyproject.toml extra ceiling. ---
pystac>=1.9,<2

# --- visualization ([vizx] extra): gbx.vizx raster rendering + GeoDataFrame map
# adapters + interactive MapLibre GL viewer (anywidget) + tile simplification
# (tippecanoe). geopandas matches requirements-dev-container.in;
# matplotlib/mapclassify/anywidget/tippecanoe are vizx-only and not in the
# dev-container lock. ---
matplotlib==3.10.9
geopandas==1.1.3
mapclassify==2.10.0
contextily==1.6.2
anywidget==0.9.18
tippecanoe==2.45.0
# IPython is what the Databricks/Jupyter runtime provides; gbx.vizx.plot_interactive
# reaches displayHTML through it (IPython.get_ipython user_ns) and falls back to
# IPython.display. test/vizx/test_interactive.py exercises both paths, so the light
# CI env needs IPython present. Pinned to the dev-container version (8.30.0).
ipython==8.30.0

# --- test runner ---
pytest==8.4.2
