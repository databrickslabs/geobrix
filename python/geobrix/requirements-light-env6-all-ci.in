# Source of truth for the protobuf-6 all-features umbrella CI lock
# (Serverless env 6 / classic DBR 19, full feature set).
# Covers: light_env6_all, light_dbr19_all — all alias geobrix[light_dbr19_all],
# the canonical pb6 all-features extra.
#
# Regenerate (from python/geobrix/), on any host: the platform is explicit so the result does not
# depend on where it runs (a Linux aarch64 host would otherwise drop the click hold below):
#   uv pip compile --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 \
#       --output-file requirements-light-env6-all-ci.txt requirements-light-env6-all-ci.in
#
# This .in uses a local-package-with-extra reference so uv expands [light_env6_all]
# directly from pyproject.toml. The [light_env6_all] extra pulls
# [light_dbr19]+[stac]+[vizx]+[zarr_dbr19] (protobuf-6 / mapbox-vector-tile>=2.2).
# ([overture] is an opt-in extra outside the _all umbrellas.)
# Protobuf-5 all-features twin: see requirements-light-env5-all-ci.in.
#
# Resolved for x86_64 Linux: the umbrella's `click>=8.2,<8.3` hold applies (it is skipped on
# Linux aarch64), so this lock carries click 8.2.1 and rasterio 1.4.3 -- the x86_64 resolution.
# On aarch64 the same extra resolves click 8.5.0 / rasterio 1.5.x (see pyproject [light_dbr19_all]).
#
# Note: CI resolves without Serverless grpcio-status constraints; the protobuf version
# in this lock (6.x) reflects the [light_dbr19] floor on mapbox-vector-tile>=2.2, NOT
# a CI grpcio constraint. The real runtime protobuf is set by the Serverless base image.

# Local package — expands geobrix[light_env6_all] from pyproject.toml
.[light_env6_all]

# pyspark is NOT a geobrix base dependency (Databricks provides it on every supported
# runtime; see pyproject.toml). This lock is for local/manual verification off-cluster,
# so pin it explicitly — same floor the base dependency used to carry.
pyspark>=4.0.0

# pillow is resolved through [vizx] (matplotlib, scikit-image, imageio, contextily) and certifi
# through requests and httpx2; the floors keep a regenerated lock at the security-patched
# releases. CI-only: the extras in pyproject.toml are unchanged, and pip leaves the runtime's own
# pillow and certifi in place.
pillow>=13.0.0
certifi>=2026.10.19
