# Per-checkout dev container settings. Copy to <checkout>/.gbx-local.env (untracked, gitignored).
#
# The main checkout needs no file: it uses geobrix-dev on 5005/8888/4040 with
# <checkout>/sample-data/Volumes at /Volumes. A linked git worktree MUST have one, or every
# gbx container command refuses to run (one checkout never touches another's container).
#
# One KEY=VALUE per line; an optional pair of double quotes around the value is removed.
# Only the keys below are accepted. Values are never printed by the tooling.

# Container name; a letter or digit first, then letters, digits, "_", "." or "-".
GBX_DEV_CONTAINER=geobrix-dev-worktree
# Host ports for the container's JDWP (5005), Jupyter (8888) and Spark UI (4040). Must differ
# from every other running container's.
GBX_DEV_PORT_JDWP=5006
GBX_DEV_PORT_JUPYTER=8889
GBX_DEV_PORT_SPARK_UI=4041

# Optional. Host directory mounted at /Volumes (default <checkout>/sample-data/Volumes).
#GBX_DEV_VOLUMES_DIR=/path/to/Volumes
# Optional. Extra bind mounts, space separated, each host:container[:ro] (no spaces inside a path).
#GBX_DEV_EXTRA_MOUNTS="/path/to/bench-corpus:/Volumes/main/default/bench-corpus:ro"
# Optional. Extra container environment, space separated KEY=VALUE (no spaces inside a value).
#GBX_DEV_DOCKER_ENV="KEY=value"
# Optional. Image tag (default ubuntu24-gdal311-spark; the per-architecture suffix is added).
#GBX_DEV_IMAGE_TAG=ubuntu24-gdal311-spark
# Optional. Cargo registry for crates (an internal mirror). Read by the Rust build commands; never
# printed, never committed.
#GBX_CARGO_REGISTRY=

# Optional. gbx:local:snapshot: a folder for the rolling project snapshots (default ~/GeoBrix-Snapshots),
# how many to keep (default 3), the largest file to include in MB (default 500), and a gitleaks binary
# for the secret scan (default: gitleaks on PATH), and comma-separated path globs of files whose secret-scan
# findings you have reviewed and accept (default: none; the scan refuses the run otherwise).
#GBX_SNAPSHOT_DIR=~/GeoBrix-Snapshots
#GBX_SNAPSHOT_KEEP=3
#GBX_SNAPSHOT_MAX_FILE_MB=500
#GBX_SNAPSHOT_GITLEAKS=
#GBX_SNAPSHOT_SCAN_ALLOW=
# Optional. gbx:local:snapshot Google Drive copy, OFF by default. GBX_SNAPSHOT_UPLOAD=1 uploads each new
# snapshot after the local write (the same as --upload); it is refused unless the secret scan was clean and
# gitleaks ran. GBX_SNAPSHOT_DRIVE_FOLDER_ID is the id of the Drive folder (from its URL), and
# GBX_SNAPSHOT_DRIVE_KEEP how many snapshots stay there (default 3). Sign-in comes from gcloud
# application-default credentials; GBX_SNAPSHOT_GCP_QUOTA_PROJECT is the Google Cloud project that bills
# the API calls, which most accounts need. Never commit the real values; this file is untracked.
# The Drive folder must be private (shared with no one): an upload or prune is refused, exit 4, if anyone
# but you can open it. GBX_SNAPSHOT_DRIVE_ALLOW_SHARED=1 accepts a shared folder.
# An upload turned on by GBX_SNAPSHOT_UPLOAD (as from the push hook) runs at most once per
# GBX_SNAPSHOT_UPLOAD_MIN_INTERVAL_MIN minutes (default 60; 0 = every run); the local snapshot always runs.
# An explicit --upload ignores that, unless --respect-throttle is given.
#GBX_SNAPSHOT_UPLOAD=
#GBX_SNAPSHOT_DRIVE_FOLDER_ID=
#GBX_SNAPSHOT_DRIVE_KEEP=3
#GBX_SNAPSHOT_GCP_QUOTA_PROJECT=
#GBX_SNAPSHOT_DRIVE_ALLOW_SHARED=
#GBX_SNAPSHOT_UPLOAD_MIN_INTERVAL_MIN=60
